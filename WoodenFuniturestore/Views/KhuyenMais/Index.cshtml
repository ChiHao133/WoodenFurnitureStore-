@model IEnumerable<WoodenFuniturestore.Models.SanPhamsViewModel>

@{
    ViewData["Title"] = "Index";
}
@if(Model!=null)
{
    <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center mb-5">
    @foreach (var item in Model)
    {
        <div class="col mb-5">

            <a style="text-decoration: none" asp-area="" asp-controller="SanPhamscustomer" asp-action="Details" asp-route-id=@item.Id>
                <div class="card h-100">
                    <!-- Sale badge-->
                    @{
                        var giaban = item.GiaBan.ToString("N0");

                        var giagoc = item.GiaGoc.ToString("N0");
                    }
                    @if ((item.GiaGoc - item.GiaBan) > 0)
                    {
                        <div class="badge bg-danger text-white position-absolute"
                             style="top: 0.5rem; right: 0.5rem">
                            -@item.PhanTramGiam %
                        </div>
                    }
                    <!-- Product image-->

                    <div class="product-image-wrapper">
                        <img class="card-img-top" src="~/images/Product/@Html.DisplayFor(models=>item.HinhAnh)" alt="..." />
                        <div class="product-overlay card-img-top">
                            <div class="overlay-content">
                                <span>Xem chi tiết</span>
                            </div>
                        </div>
                    </div>
                    <!-- Product details-->
                    <div class="card-body p-4">
                        <div class="text-align-left">
                            <h6 style="color: black" class="">@item.TenSanPham</h6>
                            <span style="color: red;">@giaban đ</span>
                            <span class="text-muted text-decoration-line-through">@giagoc đ</span>
                            <div class="d-flex justify-content-start small text-warning mb-2">
                                @for (int i = 0; i < 5; i++)
                                {
                                    if (i + 1 <= item.Rating)
                                    {
                                        <i class="bi-star-fill" style="color: black"></i>
                                    }
                                    else if (i + 1 - item.Rating < 1)
                                    {
                                        <i class="bi-star-half" style="color: black"></i>
                                    }
                                    else
                                    {
                                        <i class="bi-star" style="color: black"></i>
                                    }
                                }
                            </div>

                        </div>
                    </div>

                </div>
            </a>
        </div>
    }
</div>
}
else{
    <p>Không có sản phẩm khuyến mãi</p>
}