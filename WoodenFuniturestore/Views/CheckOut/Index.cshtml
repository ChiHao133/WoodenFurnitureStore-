@model CheckOutViewModel
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12 text-center">
            <h2>@ViewData["Title"]</h2>
            <p>Vui lòng kiểm tra thông tin trước khi đặt hàng.</p>
        </div>
    </div>

    <form asp-controller="CheckOut" asp-action="PlaceOrder" method="post">
        @Html.AntiForgeryToken()

        @foreach (var id in Model.SelectedItems)
        {
            <input type="hidden" name="SelectedItems" value="@id" />
        }
        <div class="row g-5">
            <div class="col-md-7 col-lg-7">
                <h4 class="mb-3">Thông tin giao hàng</h4>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="HoTenNhanHang" class="form-label">Họ tên người nhận</label>
                        <input asp-for="HoTenNhanHang" class="form-control" />
                        <span asp-validation-for="HoTenNhanHang" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EmailNhanHang" class="form-label">Email</label>
                        <input asp-for="EmailNhanHang" class="form-control" />
                        <span asp-validation-for="EmailNhanHang" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SoDienThoaiNhan" class="form-label">Số điện thoại</label>
                        <input asp-for="SoDienThoaiNhan" class="form-control" />
                        <span asp-validation-for="SoDienThoaiNhan" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="DiaChiGiaoHang" class="form-label">Địa chỉ</label>
                        <input asp-for="DiaChiGiaoHang" class="form-control" placeholder="123 Đường ABC, Phường X, Quận Y, TP HCM" />
                        <span asp-validation-for="DiaChiGiaoHang" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="GhiChu" class="form-label">Ghi chú (Tùy chọn)</label>
                        <textarea asp-for="GhiChu" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>

            <div class="col-md-5 col-lg-5">
                <h4 class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-primary">Đơn hàng của bạn</span>
                    <span class="badge bg-primary rounded-pill">@Model.CartItems.Count</span>
                </h4>

                <ul class="list-group mb-3">
                    @foreach (var item in Model.CartItems)
                    {
                        <li class="list-group-item d-flex justify-content-between lh-sm">
                            <div>
                                <h6 class="my-0">@item.MaSanPhamNavigation.TenSanPham</h6>
                                <small class="text-muted">Số lượng: @item.SoLuong</small>
                            </div>
                            <span class="text-muted">@(((item.SoLuong * item.GiaBan)??0).ToString("N0")) đ</span>
                        </li>
                    }
                    <li class="list-group-item d-flex justify-content-between fw-bold">
                        <span class="fw-bold fs-5">Tổng cộng</span>
                        <strong class="fs-5 text-danger">@Model.TongTien.ToString("N0") đ</strong>
                    </li>
                </ul>

                <hr class="my-4">

                <button class="w-100 btn btn-primary btn-lg" type="submit">
                    Hoàn tất Đặt hàng
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}