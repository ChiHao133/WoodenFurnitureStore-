@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WoodenFuniturestore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WoodenFuniturestore.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
            <div class="container-md flex-wrap justify-content-lg-center">
                <div class="d-flex justify-content-center align-items-center w-100 flex-wrap gap-4">
                    <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <a class="navbar-brand d-none d-lg-block me-4" asp-area="" asp-controller="Home" asp-action="Index" >
                        <img src="~/images/logo.png"
                             alt="Wooden Furniture Store" style="height: 60px;">
                    </a>
                    <a class="navbar-brand navbar-brand-mobile d-lg-none" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo.png"
                             alt="Wooden Furniture Store">
                    </a>
                    <form asp-controller="SanPhamscustomer" asp-action="Index" method="get" class="d-none d-lg-flex flex-grow-1" style="max-width: 500px; min-width: 300px;">
                        <div class="input-group">
                            <input class="form-control" type="search" name="keyword" placeholder="Tìm kiếm sản phẩm...">
                            <button class="btn btn-dark" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </form>
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center gap-1 dropdown">

                            <a href="#" class="text-dark text-decoration-none d-flex align-items-center gap-1" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle" style="font-size: 1.5rem"></i>

                                @if (User.Identity.IsAuthenticated)
                                {
                                    <span class="d-none d-lg-inline">@User.FindFirstValue(ClaimTypes.Name)</span>
                                }
                                else
                                {
                                    <span class="d-none d-lg-inline">Tài khoản</span>
                                }
                                <i class="bi bi-chevron-down d-none d-lg-inline" style="font-size: 0.7rem;"></i>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <li>
                                        <span class="dropdown-item-text">
                                            Đăng nhập bởi: <br> <strong>@User.FindFirstValue(ClaimTypes.Name)</strong>
                                        </span>
                                    </li>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2"></i>Trang quản lý
                                            </a>
                                        </li>
                                    }

                                    <li><a class="dropdown-item" href="#"><i class="bi bi-person-fill me-2"></i>Tài khoản của tôi</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-box-seam me-2"></i>Đơn hàng</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="NguoiDungs" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="NguoiDungs" asp-action="Login">
                                            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="NguoiDungs" asp-action="Register">
                                            <i class="bi bi-person-plus-fill me-2"></i>Đăng ký
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>                        
                        <a asp-controller="GioHangs" asp-action="Index" class="text-dark text-decoration-none d-flex align-items-center gap-1">
                            <i class="bi bi-bag" style="font-size: 1.5rem"></i>
                            @await Component.InvokeAsync("CartItem")
                            <span class="d-none d-lg-inline">Giỏ hàng</span>
                        </a>
                    </div>

                </div>
                <form class="d-flex d-lg-none mobile-search-form">
                    <input class="form-control me-2" type="search" placeholder="Tìm kiếm sản phẩm...">
                    <button class="btn btn-outline-dark" type="submit"><i class="bi bi-search"></i></button>
                </form>
                <div class="collapse navbar-collapse justify-content-center" id="navbarSupportedContent">
                    <ul class="navbar-nav fs-8 fw-bold">
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" href="#" id="navbarDropdownSanPham" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Sản phẩm
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownSanPham">
                                @await Component.InvokeAsync("DanhMucMenu")
                            </ul>
                        </li>

                        <li class="nav-item"><a class="nav-link text-dark" href="#">Thiết kế - Thi công</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" href="#" id="navbarDropdownKhuyenMai" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Khuyến mãi
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownKhuyenMai">
                                <li><a class="dropdown-item" href="#">Khuyến mãi 1</a></li>
                                <li><a class="dropdown-item" href="#">Khuyến mãi 2</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" href="#" id="navbarDropdownTinTuc" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Tin tức
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownTinTuc">
                                <li><a class="dropdown-item" href="#">Tin tức 1</a></li>
                                <li><a class="dropdown-item" href="#">Tin tức 2</a></li>
                            </ul>
                        </li>

                        <li class="nav-item"><a class="nav-link text-dark" href="#">Về Wooden Furniture Store</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" href="#">Cửa hàng</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-light text-dark pt-5 pb-4 mt-5 border-top">
        <div class="container-md text-center text-md-start">
            <div class="row text-center text-md-start">

                <!-- Cột 1: Về cửa hàng -->
                <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 fw-bold">Wooden Furniture Store</h5>
                    <p>
                        Mang đến những sản phẩm nội thất bằng gỗ chất lượng cao,
                        thiết kế tinh tế và bền vững với thời gian.
                    </p>
                    <a class="navbar-brand" href="#">
                        <img src="~/images/logo.png" alt="Wooden Furniture Store" style="height: 50px;">
                    </a>
                </div>

                <!-- Cột 2: Chính sách -->
                <div class="col-md-3 col-lg-2 col-xl-2 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 fw-bold">Chính sách</h5>
                    <p><a href="#" class="text-dark text-decoration-none">Chính sách giao hàng</a></p>
                    <p><a href="#" class="text-dark text-decoration-none">Chính sách đổi trả</a></p>
                    <p><a href="#" class="text-dark text-decoration-none">Chính sách bảo hành</a></p>
                    <p><a href="#" class="text-dark text-decoration-none">Chính sách bảo mật</a></p>
                </div>

                <!-- Cột 3: Hỗ trợ -->
                <div class="col-md-3 col-lg-2 col-xl-2 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 fw-bold">Hỗ trợ</h5>
                    <p><a href="#" class="text-dark text-decoration-none">Câu hỏi thường gặp</a></p>
                    <p><a href="#" class="text-dark text-decoration-none">Hướng dẫn mua hàng</a></p>
                    <p><a href="#" class="text-dark text-decoration-none">Liên hệ</a></p>
                    <p><a href="#" class="text-dark text-decoration-none">Về chúng tôi</a></p>
                </div>

                <!-- Cột 4: Liên hệ & Mạng xã hội -->
                <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 fw-bold">Liên hệ</h5>
                    <p><i class="bi bi-geo-alt-fill me-2"></i> 123 Đường ABC, Quận 1, TP. HCM</p>
                    <p><i class="bi bi-envelope-fill me-2"></i> info@woodenfurniture.com</p>
                    <p><i class="bi bi-telephone-fill me-2"></i> +84 234 567 88</p>
                    <!-- Mạng xã hội -->
                    <div class="mt-4">
                        <a href="#" class="btn btn-dark btn-floating m-1" role="button">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="#" class="btn btn-dark btn-floating m-1" role="button">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="#" class="btn btn-dark btn-floating m-1" role="button">
                            <i class="bi bi-youtube"></i>
                        </a>
                        <a href="#" class="btn btn-dark btn-floating m-1" role="button">
                            <i class="bi bi-pinterest"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Copyright -->
            <hr class="my-4">
            <div class="row align-items-center">
                <div class="col-md-7 col-lg-8">
                    <p class="text-center text-md-start mb-3 mb-md-0">
                        © 2024 Copyright:
                        <a href="#" class="text-dark text-decoration-none fw-bold">WoodenFurnitureStore.com</a>
                    </p>
                </div>
                <div class="col-md-5 col-lg-4">
                    <div class="text-center text-md-end">
                        <!-- Có thể thêm hình ảnh các phương thức thanh toán ở đây -->
                        <i class="bi bi-credit-card-2-front-fill fs-4 mx-1"></i>
                        <i class="bi bi-paypal fs-4 mx-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
