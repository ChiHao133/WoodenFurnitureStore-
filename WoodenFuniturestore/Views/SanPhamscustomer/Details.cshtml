@model WoodenFuniturestore.Models.SanPham

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container my-5">
    <div class="row">

        <div class="col-md-7">
            <div class="row">
                <div class="col-md-2 product-thumbnails">
                    <img src="~/images/banghe1.jpg" alt="Thumbnail 1" class="img-fluid mb-2 border rounded">
                </div>

                <div class="col-md-10">
                    <img src="~/images/banghe1.jpg" alt="@Model.TenSanPham" class="img-fluid rounded">
                </div>

            </div>
        </div> <div class="col-md-5 product-details">

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">TRANG CHỦ</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="SanPham">SẢN PHẨM</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.TenSanPham</li>
                </ol>
            </nav>

            <h1 class="product-title">@Model.TenSanPham</h1>

            <div class="product-price my-3">
                @Model.Gia.ToString("N0")đ
            </div>

            <form asp-controller="GioHangs" asp-action="ThemVaoGio" method="post">
                <input type="hidden" asp-for="SanPhamId" />

                <label class="form-label fw-bold">Số lượng:</label>
                <div class="quantity-selector d-flex align-items-center border mb-3">
                    <input type="number" name="name" value="" min="1" max="@Model.SoLuongTon"/>
                </div>

                <button type="submit" class="btn btn-dark w-100 btn-lg">
                    Thêm vào giỏ
                </button>
            </form>

            <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Quay lại danh sách</a>


            <div class="product-description mt-4">
                <h6 class="fw-bold">MÔ TẢ CHI TIẾT</h6>
                <p>@Model.MoTa</p>
                <ul>
                    <li><strong>Chất liệu:</strong> @Model.ChatLieu?.TenChatLieu</li>
                    <li><strong>Kích thước:</strong> @Model.KichThuoc</li>
                    <li><strong>Danh mục:</strong> @Model.DanhMuc?.TenDanhMuc</li>
                    <li><strong>Số lượng còn:</strong> @Model.SoLuongTon</li>
                </ul>
            </div>

        </div>
    </div>
</div> ```

